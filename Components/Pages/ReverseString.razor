@page "/reversestring"

@using System.Text.RegularExpressions;

<PageTitle>Reverse A String</PageTitle>
<h3>Reverse a String</h3>

<div class="vstack gap-3 col-8 col-md-6">
    <InputText class="form-control" placeholder="Enter a string to reverse" @bind-value="inputString" />
    <div class="text-end">
        <button class="btn btn-primary" @onclick="ReverseTheString">Reverse Me</button>
    </div>
    <hr/>
    @if (displayMessage != string.Empty)
    {
        <Message DisplayMessage="@displayMessage" Title=@title CssClass=@color />
    }
</div>

@code {
    // Bound Values
    private string inputString = string.Empty;// = "Reverse Me";

    // Parameter Values
    private string title = string.Empty;// "Result";
    private string color = string.Empty;// "alert-danger";

    // Local Variables
    private string reversedMessage = string.Empty;
    private string displayMessage = string.Empty;
    private bool isPalindrome = false;

    private void ReverseTheString()
    {
        isPalindrome = false; // Reset the palindrome check

        if(inputString != "") {
            reversedMessage = new string(inputString.Reverse().ToArray());
            displayMessage = $"The reverse of {inputString} is {reversedMessage}";

            isPalindrome = (CleanString(inputString) == CleanString(reversedMessage)) ? true : false;
        }
        else
        {
            reversedMessage = displayMessage = string.Empty;
            isPalindrome = false;
        }

        if (isPalindrome)
        {
            title = "Palindrome";
            color = "alert-success";
        }
        else
        {
            title = "Not a Palindrome";
            color = "alert-danger";
        }
    }

    private string CleanString(string input)
    {
        return Regex.Replace(input, "[^a-zA-Z0-9]", "").ToLower();
    }
}
