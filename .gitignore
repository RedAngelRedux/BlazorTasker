# Ignore Visual Studio specific files
.vs/
*.user
*.suo
*.cache
*.pdb
*.ilk
*.aps
*.ncb
*.opendb
*.log

# Ignore build artifacts
bin/
obj/
*.exe
*.dll
*.log
*.lib
*.jar
*.rpt
*.res

# Ignore NuGet packages
packages/
*.nupkg
project.lock.json
project.assets.json

# Ignore compiled Python files (if applicable)
__pycache__/
*.pyc
*.pyo
*.pyd

# Ignore IDE settings
.idea/
*.DS_Store
*.log

# Ignore autogenerated files
Generated/
Debug/
Release/
x64/
x86/

# Ignore database files
*.mdf
*.ldf

# Ignore build dependencies
.vscode/
node_modules/
bower_components/

# Ignore environment and config files
.env
*.config
